# La app móvil NO lee secretos de variables de entorno.
# Estas variables son para el backend opcional del asistente
# (docs/backend-asistente/index.ts) y deben configurarse como secretos del servidor.
ANTHROPIC_API_KEY=
AUREA_ACCESS_TOKEN=
PORT=8787

# Firma release: defínelas en ~/.gradle/gradle.properties (fuera del repositorio), no aquí.
# AUREA_RELEASE_STORE_FILE=
# AUREA_RELEASE_STORE_PASSWORD=
# AUREA_RELEASE_KEY_ALIAS=
# AUREA_RELEASE_KEY_PASSWORD=
